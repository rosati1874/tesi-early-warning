# Connection string Postgres di Supabase (Project Settings -> Database)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/postgres

# API key Gemini free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Notifiche Webhook (true/false)
ENABLE_WEBHOOK_NOTIFICATIONS=false

# Notifiche Email (true/false)
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuo-account@gmail.com
SMTP_PASSWORD=tua-password-per-le-app
EMAIL_SENDER=tuo-account@gmail.com
EMAIL_SENDER_NAME=Early Warning Epidemico

# Finestra temporale di monitoraggio in giorni (default 30)
MONITORING_WINDOW_DAYS=30
